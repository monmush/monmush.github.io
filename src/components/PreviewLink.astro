---
import LinkArrow from './LinkArrow.astro';
interface Props {
  label: string;
  preview: string;
  image: string;
  url?: string | null;
  title: string;
  caption?: string;
  imageWidth?: number;
  imageHeight?: number;
}
const { label, image, url, title, preview, caption = '', imageWidth = 584, imageHeight = 329 } = Astro.props;
const shared = {
  'data-preview': preview,
  'data-image': image,
  'data-title': title,
  'data-url': url || '',
  'data-caption': caption,
  'data-image-width': imageWidth,
  'data-image-height': imageHeight,
};
---
{url ? (
  <a class="preview-trigger" href={url} target="_blank" rel="noopener noreferrer" {...shared}>
    {label}<LinkArrow />
    <span class="sr-only"> (opens in a new tab)</span>
  </a>
) : (
  <button class="preview-trigger" type="button" aria-haspopup="dialog" {...shared}>
    {label}<LinkArrow />
    <span class="sr-only"> — preview</span>
  </button>
)}
